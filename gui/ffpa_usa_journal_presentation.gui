# USA-only, stateless journal widgets. Existing native/CMF time bars stay attached.
types ffpa_usa_journal_widgets {
 type ffpa_usa_ui_market = vbox {
  spacing = 10
  textbox = { text = "[JournalEntry.GetCountry.GetCustom('ffpa_usa_ui_market_status')]" autoresize = yes multiline = yes max_width = 504 }
  icon = { size = { 504 2 } texture = "gfx/interface/dividers/divider_clean.dds" }
  textbox = { text = ffpa_usa_ui_conditions autoresize = yes multiline = yes max_width = 504 }
  hbox = {
   spacing = 10
   tooltip = ffpa_usa_market_population_tt
   widget = { size = { 18 18 } parentanchor = vcenter icon = { size = { 18 18 } visible = "[GetScriptedGui('ffpa_usa_ui_population').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]" texture = "gfx/interface/icons/generic_icons/checkmark.dds" } }
   vbox = { spacing = 2 textbox = { text = ffpa_usa_ui_population autoresize = yes multiline = yes max_width = 374 } }
   textbox = { text = ffpa_usa_ui_met autoresize = yes visible = "[GetScriptedGui('ffpa_usa_ui_population').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]" }
   textbox = { text = ffpa_usa_ui_unmet autoresize = yes visible = "[Not(GetScriptedGui('ffpa_usa_ui_population').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End))]" }
  }
  hbox = {
   spacing = 10
   tooltip = ffpa_usa_market_facilities_tt
   widget = { size = { 18 18 } parentanchor = vcenter icon = { size = { 18 18 } visible = "[GetScriptedGui('ffpa_usa_ui_facilities').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]" texture = "gfx/interface/icons/generic_icons/checkmark.dds" } }
   vbox = { spacing = 2 textbox = { text = ffpa_usa_ui_facilities autoresize = yes multiline = yes max_width = 374 } }
   textbox = { text = ffpa_usa_ui_met autoresize = yes visible = "[GetScriptedGui('ffpa_usa_ui_facilities').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]" }
   textbox = { text = ffpa_usa_ui_unmet autoresize = yes visible = "[Not(GetScriptedGui('ffpa_usa_ui_facilities').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End))]" }
  }
  textbox = { text = ffpa_usa_ui_market_rules autoresize = yes multiline = yes max_width = 504 }
  icon = { size = { 504 2 } texture = "gfx/interface/dividers/divider_clean.dds" }
  textbox = { text = ffpa_usa_ui_grants autoresize = yes multiline = yes max_width = 504 tooltip = ffpa_usa_ui_grants_tip }
  textbox = { text = ffpa_usa_ui_market_outcomes autoresize = yes multiline = yes max_width = 504 tooltip = ffpa_usa_ui_market_outcomes_tt }
 }
