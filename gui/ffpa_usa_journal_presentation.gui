   textbox = { text = ffpa_usa_gov_risk_penalty_clock_v1 autoresize = yes multiline = yes max_width = 504 visible = "[GetScriptedGui('ffpa_usa_gov_risk_penalty_visible_v1').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]" tooltip = "[JournalEntry.GetCountry.GetTimedModifier('ffpa_usa_gov_risk_penalty_v1').GetTooltip]" }
